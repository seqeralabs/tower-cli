{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["gradle", "gradle-wrapper", "github-actions"],
  "schedule": ["after 10pm on sunday", "before 6am on monday"],
  "packageRules": [
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "gradle minor and patch"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "github actions"
    },
    {
      "description": "picocli-codegen 4.7.x rejects the @ArgGroup in VersionRefOptions; hold at 4.6.x until it compiles (see #583, #616)",
      "matchPackageNames": ["info.picocli:picocli", "info.picocli:picocli-codegen"],
      "allowedVersions": "<4.7.0"
    }
  ]
}
